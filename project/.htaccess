# ============================================================
# Performance rules for Apache/cPanel hosts (e.g. BYU-Pathway
# student hosting). Ignored harmlessly by GitHub Pages,
# Netlify, or other hosts that do not use .htaccess.
# ============================================================

# ---- Compression (gzip) for text-based assets ----
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

# ---- Browser caching ----
<IfModule mod_expires.c>
    ExpiresActive On

    # HTML: short cache so edits show up quickly
    ExpiresByType text/html "access plus 0 seconds"

    # CSS, JS, fonts: cache for a week (safe because files are rarely renamed)
    ExpiresByType text/css "access plus 1 week"
    ExpiresByType application/javascript "access plus 1 week"
    ExpiresByType font/woff2 "access plus 1 month"
    ExpiresByType application/font-woff2 "access plus 1 month"

    # Images: cache for a month
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
</IfModule>

# ETags are already sent by Apache; the Expires headers above
# let browsers reuse cached files without revalidation.
